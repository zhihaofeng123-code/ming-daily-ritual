{
  "name": "@kylon-template/general-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "predev": "pnpm generate:contracts",
    "dev": "next dev",
    "generate:contracts": "tsx scripts/generate-contracts.ts",
    "prebuild": "pnpm validate:push && node scripts/upload-contract-snapshot.mjs",
    "build": "next build",
    "start": "next start",
    "test": "tsx --test lib/*.test.ts lib/time/*.test.ts lib/time/**/*.test.ts components/ui/data-table/*.test.ts",
    "test:time": "tsx --test lib/time/*.test.ts lib/time/**/*.test.ts",
    "validate": "pnpm validate:push",
    "validate:push": "pnpm generate:contracts && next typegen && tsc --noEmit",
    "typecheck": "pnpm validate:push",
    "test:ming": "tsx scripts/ming/verify.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@streamdown/code": "^1.1.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-virtual": "^3.14.10",
    "astronomia": "^4.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.18.0",
    "next": "^16.2.9",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "radix-ui": "^1.5.0",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "lunar-javascript": "^1.7.7",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.8.0"
}
